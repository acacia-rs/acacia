{
  "name": "@acacia-rs/mcp",
  "version": "0.1.0",
  "description": "An MCP server that lets LLM agents drive acacia Minecraft Bedrock bots",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acacia-rs/acacia.git",
    "directory": "packages/acacia-mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "acacia-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build --prefix ../acacia-bot && npm run build:ts",
    "build:test": "npm run build:test --prefix ../acacia-bot && npm run build:ts",
    "build:ts": "node scripts/sync-methods.mjs && tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec 'test/*.test.mjs'"
  },
  "dependencies": {
    "@acacia-rs/bot": "^0.1.0",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
