# Basics
math.abs(-2.5)
math.ceil(1.2)
math.ceil(-1.2)
math.floor(1.8)
math.floor(-1.8)
math.trunc(1.8)
math.trunc(-1.8)
math.round(2.5)
math.round(-2.5)
math.round(2.4)
math.round(0.5)
math.round(1.5)
math.sign(-3)
math.sign(0)
math.sign(4)
math.copy_sign(3, -1)
math.copy_sign(-3, 1)
math.min(2, -3)
math.max(2, -3)
math.clamp(5, 1, 3)
math.clamp(-5, 1, 3)
math.clamp(5, 3, 1)
math.mod(7, 3)
math.mod(-7, 3)
math.mod(7, -3)
math.mod(7.5, 2)
math.mod(7, 0)
math.pow(2, 10)
math.pow(2, 0.5)
math.pow(-8, 0.5)
math.pow(0, 0)
math.sqrt(2)
math.sqrt(-4)
math.exp(1)
math.ln(10)
math.ln(0)
math.ln(-1)
math.pi

# Out-of-domain results: not-a-number is the only value unequal to itself
v.r = math.sqrt(-4); => v.r == v.r
v.r = math.pow(-8, 0.5); => v.r == v.r
v.r = math.asin(2); => v.r == v.r
v.r = math.mod(7, 0); => v.r == v.r
v.r = math.ln(-1); => v.r == v.r
v.r = math.ln(0); => v.r < -1000000000
v.r = math.inverse_lerp(2, 2, 3); => v.r > 1000000000

# Trigonometry is in degrees
math.sin(0)
math.sin(30)
math.sin(90)
math.sin(180)
math.sin(360)
math.sin(-45)
math.sin(1000000)
math.cos(0)
math.cos(60)
math.cos(90)
math.cos(180)
math.asin(0.5)
math.asin(2)
math.acos(0.5)
math.acos(-2)
math.atan(1)
math.atan2(1, 1)
math.atan2(1, -1)
math.atan2(-1, -1)
math.atan2(0, 0)

# Interpolation
math.lerp(2, 6, 0.25)
math.lerp(2, 6, 1.5)
math.lerp(2, 6, -1)
math.inverse_lerp(2, 6, 3)
math.inverse_lerp(2, 2, 3)
math.inverse_lerp(2, 6, 10)
math.lerprotate(10, 350, 0.5)
math.lerprotate(350, 10, 0.5)
math.lerprotate(0, 90, 0.25)
math.lerprotate(0, 180, 0.5)
math.lerprotate(0, 270, 0.5)
math.lerprotate(-170, 170, 0.5)
math.min_angle(270)
math.min_angle(-270)
math.min_angle(180)
math.min_angle(-180)
math.min_angle(540)
math.min_angle(725)
math.hermite_blend(0)
math.hermite_blend(0.25)
math.hermite_blend(0.5)
math.hermite_blend(1)
math.hermite_blend(2)

# Random: only bounds that leave one answer, and range checks
math.random(3, 3)
math.random_integer(4, 4)
math.die_roll(3, 2, 2)
math.die_roll_integer(3, 2, 2)
math.die_roll(0, 1, 5)
v.r = math.random(2, 5); => v.r >= 2 && v.r <= 5
v.r = math.random_integer(2, 5); => v.r == math.floor(v.r) && v.r >= 2 && v.r <= 5
v.r = math.die_roll(4, 1, 2); => v.r >= 4 && v.r <= 8
v.r = math.random(5, 2); => v.r >= 2 && v.r <= 5

# Easing: (start, end, 0 to 1)
