# Basics
math.abs(-2.5)
math.ceil(1.2)
math.ceil(-1.2)
math.floor(1.8)
math.floor(-1.8)
math.trunc(1.8)
math.trunc(-1.8)
math.round(2.5)
math.round(-2.5)
math.round(2.4)
math.round(0.5)
math.round(1.5)
math.sign(-3)
math.sign(0)
math.sign(4)
math.copy_sign(3, -1)
math.copy_sign(-3, 1)
math.min(2, -3)
math.max(2, -3)
math.clamp(5, 1, 3)
math.clamp(-5, 1, 3)
math.clamp(5, 3, 1)
math.mod(7, 3)
math.mod(-7, 3)
math.mod(7, -3)
math.mod(7.5, 2)
math.mod(7, 0)
math.pow(2, 10)
math.pow(2, 0.5)
math.pow(-8, 0.5)
math.pow(0, 0)
math.sqrt(2)
math.sqrt(-4)
math.exp(1)
math.ln(10)
math.ln(0)
math.ln(-1)
math.pi

# Out-of-domain results: not-a-number is the only value unequal to itself
v.r = math.sqrt(-4); => v.r == v.r
v.r = math.pow(-8, 0.5); => v.r == v.r
v.r = math.asin(2); => v.r == v.r
v.r = math.mod(7, 0); => v.r == v.r
v.r = math.ln(-1); => v.r == v.r
v.r = math.ln(0); => v.r < -1000000000
v.r = math.inverse_lerp(2, 2, 3); => v.r > 1000000000

# Trigonometry is in degrees
math.sin(0)
math.sin(30)
math.sin(90)
math.sin(180)
math.sin(360)
math.sin(-45)
math.sin(1000000)
math.cos(0)
math.cos(60)
math.cos(90)
math.cos(180)
math.asin(0.5)
math.asin(2)
math.acos(0.5)
math.acos(-2)
math.atan(1)
math.atan2(1, 1)
math.atan2(1, -1)
math.atan2(-1, -1)
math.atan2(0, 0)

# Interpolation
math.lerp(2, 6, 0.25)
math.lerp(2, 6, 1.5)
math.lerp(2, 6, -1)
math.inverse_lerp(2, 6, 3)
math.inverse_lerp(2, 2, 3)
math.inverse_lerp(2, 6, 10)
math.lerprotate(10, 350, 0.5)
math.lerprotate(350, 10, 0.5)
math.lerprotate(0, 90, 0.25)
math.lerprotate(0, 180, 0.5)
math.lerprotate(0, 270, 0.5)
math.lerprotate(-170, 170, 0.5)
math.min_angle(270)
math.min_angle(-270)
math.min_angle(180)
math.min_angle(-180)
math.min_angle(540)
math.min_angle(725)
math.hermite_blend(0)
math.hermite_blend(0.25)
math.hermite_blend(0.5)
math.hermite_blend(1)
math.hermite_blend(2)

# Random: only bounds that leave one answer, and range checks
math.random(3, 3)
math.random_integer(4, 4)
math.die_roll(3, 2, 2)
math.die_roll_integer(3, 2, 2)
math.die_roll(0, 1, 5)
v.r = math.random(2, 5); => v.r >= 2 && v.r <= 5
v.r = math.random_integer(2, 5); => v.r == math.floor(v.r) && v.r >= 2 && v.r <= 5
v.r = math.die_roll(4, 1, 2); => v.r >= 4 && v.r <= 8
v.r = math.random(5, 2); => v.r >= 2 && v.r <= 5

# Easing: (start, end, 0 to 1)
math.ease_in_quad(10, 20, 0.25)
math.ease_out_quad(10, 20, 0.25)
math.ease_in_out_quad(10, 20, 0.25)
math.ease_in_out_quad(10, 20, 0.75)
math.ease_in_cubic(10, 20, 0.25)
math.ease_out_cubic(10, 20, 0.25)
math.ease_in_out_cubic(10, 20, 0.25)
math.ease_in_out_cubic(10, 20, 0.75)
math.ease_in_quart(10, 20, 0.25)
math.ease_out_quart(10, 20, 0.25)
math.ease_in_out_quart(10, 20, 0.25)
math.ease_in_out_quart(10, 20, 0.75)
math.ease_in_quint(10, 20, 0.25)
math.ease_out_quint(10, 20, 0.25)
math.ease_in_out_quint(10, 20, 0.25)
math.ease_in_out_quint(10, 20, 0.75)
math.ease_in_sine(10, 20, 0.25)
math.ease_out_sine(10, 20, 0.25)
math.ease_in_out_sine(10, 20, 0.25)
math.ease_in_expo(10, 20, 0.25)
math.ease_in_expo(10, 20, 0)
math.ease_out_expo(10, 20, 0.25)
math.ease_out_expo(10, 20, 1)
math.ease_in_out_expo(10, 20, 0.25)
math.ease_in_out_expo(10, 20, 0.75)
math.ease_in_circ(10, 20, 0.25)
math.ease_out_circ(10, 20, 0.25)
math.ease_in_out_circ(10, 20, 0.25)
math.ease_in_out_circ(10, 20, 0.75)
math.ease_in_back(10, 20, 0.25)
math.ease_out_back(10, 20, 0.25)
math.ease_in_out_back(10, 20, 0.25)
math.ease_in_out_back(10, 20, 0.75)
math.ease_in_elastic(10, 20, 0.25)
math.ease_out_elastic(10, 20, 0.25)
math.ease_in_out_elastic(10, 20, 0.25)
math.ease_in_out_elastic(10, 20, 0.75)
math.ease_in_bounce(10, 20, 0.25)
math.ease_out_bounce(10, 20, 0.25)
math.ease_out_bounce(10, 20, 0.5)
math.ease_out_bounce(10, 20, 0.8)
math.ease_out_bounce(10, 20, 0.95)
math.ease_in_out_bounce(10, 20, 0.25)
math.ease_in_out_bounce(10, 20, 0.75)
math.ease_in_quad(10, 20, 1.5)
math.ease_in_quad(10, 20, -0.5)

# Argument counts
math.abs()
math.abs(1, 2)
math.min(1)
math.clamp(1, 2)
math.nonexistent(1)

# Crossed clamp bounds; not-a-number through min and max; mod by zero, folded and evaluated
math.clamp(1, 2.5, 1.5)
math.clamp(-1.5, 1.5, 0)
math.clamp(2, 2.5, 1.5)
math.clamp(3, 2.5, 1.5)
v.z = 0; v.lo = 2.5; v.hi = 1.5; => math.clamp(v.z + 1, v.lo, v.hi)
v.z = 0; v.lo = 2.5; v.hi = 1.5; => math.clamp(v.z + 3, v.lo, v.hi)
v.z = 0; v.lo = 2.5; v.hi = 1.5; => math.clamp(v.z + 2, v.lo, v.hi)
math.min(math.mod(0, 0), -2)
math.max(math.mod(0, 0), -2)
v.z = 0; => math.min(-2, math.mod(v.z, v.z))
v.z = 0; => math.min(math.mod(v.z, v.z), -2)
v.z = 0; => math.max(-2, math.mod(v.z, v.z))
v.z = 0; => math.max(math.mod(v.z, v.z), -2)
math.mod(0, 0) == math.mod(0, 0)
v.z = 0; => math.mod(v.z, v.z) == math.mod(v.z, v.z)
math.mod(1, 1 / 0) == math.mod(1, 1 / 0)
v.z = 0; => math.mod(1, 1 / v.z) == math.mod(1, 1 / v.z)
v.z = 0; => 1 / v.z
v.z = 0; => math.mod(v.z, v.z) < 1
v.z = 0; => math.mod(v.z, v.z) > 1
v.z = 0; => !math.mod(v.z, v.z)
v.z = 0; => math.mod(v.z, v.z) ? 1 : 2
v.z = 0; => math.mod(v.z, v.z) && 1
v.z = 0; => math.clamp(math.mod(v.z, v.z), 3, 5)
v.z = 0; => math.clamp(4, math.mod(v.z, v.z), 5)
v.z = 0; => math.clamp(4, 3, math.mod(v.z, v.z))
v.z = 0; => math.abs(math.mod(v.z, v.z)) == 0
v.z = 0; => math.round(math.mod(v.z, v.z)) == 0
v.z = 0; => math.sign(math.mod(v.z, v.z))
v.z = 0; => math.lerp(1, 2, math.mod(v.z, v.z)) == 0
v.z = 0; => math.mod(v.z, v.z) + 1 == 1
v.z = 0; => math.mod(v.z, v.z) * 0 == 0
v.z = 0; => math.sqrt(v.z - 4) == 0
v.z = 0; => math.sqrt(v.z - 4) ? 1 : 2
v.z = 0; => math.mod(v.z, v.z) != math.mod(v.z, v.z)
math.min(-2, math.mod(0, 0)) == -2
math.max(-2, math.mod(0, 0)) == -2
math.min(-2, math.mod(0, 0)) < 0
v.a = 1.5; v.z = 0; => math.mod(v.a, 0) == math.mod(v.a, 0)
v.a = 1.5; v.z = 0; => math.mod(v.a, 0 + 0) == math.mod(v.a, 0 + 0)
v.a = 1.5; v.z = 0; => math.mod(v.a, math.clamp(0, 0, 0)) == math.mod(v.a, math.clamp(0, 0, 0))
v.a = 1.5; v.z = 0; => math.mod(v.a, v.z) == math.mod(v.a, v.z)
v.a = 1.5; v.z = 0; => math.mod(v.a, v.z * 1) == math.mod(v.a, v.z * 1)
v.a = 1.5; v.z = 0; => math.mod(3, v.z) == math.mod(3, v.z)
v.a = 1.5; v.z = 0; => math.mod(v.a, 0) ? 1 : 2
v.a = 1.5; v.z = 0; => math.mod(v.a, v.z) ? 1 : 2
v.a = 1.5; v.z = 0; => v.a / 0
v.a = 1.5; v.z = 0; => v.a / 0 == 0
v.a = 1.5; v.z = 0; => v.a / v.z == 0
v.a = 1.5; v.z = 0; v.r = 5; v.r = math.mod(v.a, 0); => v.r
v.a = 1.5; v.z = 0; v.r = 5; v.r = math.mod(v.a, v.z); => v.r
v.a = 1.5; v.z = 0; => math.mod(v.a, 2) == 1.5
v.a = 1.5; v.z = 0; => math.mod(v.a, -0) == math.mod(v.a, -0)

# Division by a constant is a multiplication by its reciprocal
v.a = 5; => v.a / 3 == v.a * (1 / 3)
v.a = 5; v.c = 3; => v.a / v.c == v.a * (1 / 3)
v.a = 5; => v.a / 49 == v.a * (1 / 49)
v.a = 5; v.c = 49; => v.a / v.c == v.a * (1 / 49)
v.a = 7; => v.a / 3 == v.a * (1 / 3)
v.a = 7; v.c = 3; => v.a / v.c == v.a * (1 / 3)
v.a = 7; => v.a / 49 == v.a * (1 / 49)
v.a = 7; v.c = 49; => v.a / v.c == v.a * (1 / 49)
v.a = 10; => v.a / 3 == v.a * (1 / 3)
v.a = 10; v.c = 3; => v.a / v.c == v.a * (1 / 3)
v.a = 10; => v.a / 49 == v.a * (1 / 49)
v.a = 10; v.c = 49; => v.a / v.c == v.a * (1 / 49)
v.a = 1.7; => v.a / 3 == v.a * (1 / 3)
v.a = 1.7; v.c = 3; => v.a / v.c == v.a * (1 / 3)
v.a = 1.7; => v.a / 49 == v.a * (1 / 49)
v.a = 1.7; v.c = 49; => v.a / v.c == v.a * (1 / 49)
(5 / 3) == 5 * (1 / 3)
(7 / 49) == 7 * (1 / 49)
