          "bot": {
            "$ref": "#/$defs/BotId"
          },
          "x": {
            "format": "int32",
            "type": "integer"
          },
          "y": {
            "format": "int32",
            "type": "integer"
          },
          "z": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "bot",
          "x",
          "y",
          "z"
        ],
        "title": "DigParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "null",
        "type": "null"
      }
    },
    {
      "description": "Answers an open form after a human reading delay.",
      "flags": [
        "mcp"
      ],
      "lane": "queued",
      "name": "bot.answerForm",
      "params": {
        "$defs": {
          "BotId": {
